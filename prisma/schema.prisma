generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Store {
  id                 String   @id @default(uuid())
  shop               String   @unique
  plan               String   @default("FREE")
  subscriptionId     String?
  subscriptionStatus String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  widgets            Widget[]
}

model Widget {
  id           String        @id @default(uuid())
  shop         String
  widgetId     String        @unique
  name         String
  type         String
  design       String
  status       String        @default("Active")
  settings     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  integrations Integration[]
  socialLinks  SocialLink[]
  store        Store         @relation(fields: [shop], references: [shop])
}

model SocialLink {
  id           String  @id @default(uuid())
  widgetId     String
  platform     String
  url          String
  enabled      Boolean @default(true)
  displayOrder Int
  widget       Widget  @relation(fields: [widgetId], references: [widgetId], onDelete: Cascade)
}

model Integration {
  id              String   @id @default(uuid())
  shop            String
  widgetId        String
  integrationType String
  targetSelector  String?
  status          String   @default("Active")
  settings        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  widget          Widget   @relation(fields: [widgetId], references: [widgetId], onDelete: Cascade)
}
